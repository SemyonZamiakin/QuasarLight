<Window x:Class="QuasarLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quasar Light" Width="1240" Height="780" MinWidth="1100" MinHeight="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable Display, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border Margin="14" CornerRadius="26" Background="#0A0C13" BorderBrush="#22FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <Grid>
            <!-- animated aurora background -->
            <Canvas x:Name="Aurora" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="BlobA" Width="620" Height="620" Canvas.Left="-160" Canvas.Top="-200" Opacity="0.30">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8B6CFF" Offset="0"/><GradientStop Color="#008B6CFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="TA"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobB" Width="560" Height="560" Canvas.Left="760" Canvas.Top="380" Opacity="0.22">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#38D9F0" Offset="0"/><GradientStop Color="#0038D9F0" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="TB"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobC" Width="420" Height="420" Canvas.Left="420" Canvas.Top="120" Opacity="0.14">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF4FA3" Offset="0"/><GradientStop Color="#00FF4FA3" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="TC"/></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- title bar -->
                <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                        <Ellipse Width="26" Height="26" Fill="{StaticResource AccentGradient}">
                            <Ellipse.Effect><DropShadowEffect Color="#8B6CFF" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Margin="12,0,0,0" FontSize="19" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#B9A8FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>QUASAR LIGHT</TextBlock>
                        <TextBlock Text="RGB CONTROL" Margin="10,3,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinBtn}" Click="Min_Click" ToolTip="Minimize">
                            <Rectangle Width="12" Height="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="Close_Click" ToolTip="Hide to tray">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="28,0,28,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- sidebar -->
                    <DockPanel Grid.Column="0" Margin="0,0,24,0">
                        <Border DockPanel.Dock="Bottom" CornerRadius="16" Padding="16" Margin="0,10,0,0"
                                Background="#14FFB84D" BorderBrush="#40FFB84D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="PREVIEW MODE" FontSize="11" FontWeight="Bold" Foreground="#FFB84D"/>
                                <TextBlock x:Name="ModeNote" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="#D8CBB5"
                                           Text="Hardware control needs a signed SMBus/USB driver and a verified device plugin. Effects are simulated here; nothing is written to your devices."/>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="DEVICES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="4,8,0,12"/>
                            <StackPanel x:Name="DeviceList"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- stage -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,4,0,0">
                            <TextBlock x:Name="StageTitle" FontSize="26" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="StageSub" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="0,18,0,18" CornerRadius="22" ClipToBounds="True"
                                Background="#B00C0E16" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Viewbox Stretch="Uniform" Margin="14">
                                <Canvas x:Name="Stage" Width="620" Height="440"/>
                            </Viewbox>
                        </Border>
                        <Border Grid.Row="2" CornerRadius="16" Padding="18,14" Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <TextBlock x:Name="InfoText" FontSize="12.5" Foreground="#C5CADB" TextWrapping="Wrap" LineHeight="20"/>
                        </Border>
                    </Grid>

                    <!-- control panel -->
                    <Border Grid.Column="2" Margin="24,0,0,0" CornerRadius="22" Padding="22" Background="#0FFFFFFF"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="EFFECT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                                <WrapPanel x:Name="EffectPanel"/>

                                <TextBlock Text="COLORS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Target1" GroupName="ct" IsChecked="True" Style="{StaticResource Chip}" Content="Primary" Checked="Target_Changed"/>
                                    <RadioButton x:Name="Target2" GroupName="ct" Style="{StaticResource Chip}" Content="Secondary" Checked="Target_Changed"/>
                                </StackPanel>
                                <WrapPanel x:Name="Palette" Margin="0,0,0,4"/>
                                <TextBlock Text="HUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,6"/>
                                <Grid>
                                    <Border Height="10" CornerRadius="5" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.17"/>
                                                <GradientStop Color="#00FF00" Offset="0.33"/><GradientStop Color="#00FFFF" Offset="0.5"/>
                                                <GradientStop Color="#0000FF" Offset="0.67"/><GradientStop Color="#FF00FF" Offset="0.83"/>
                                                <GradientStop Color="#FF0000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Style="{StaticResource QSlider}" Opacity="0.01"
                                            ValueChanged="Hue_Changed"/>
                                    <Canvas IsHitTestVisible="False" Height="24">
                                        <Ellipse x:Name="HueThumb" Width="18" Height="18" Fill="White" Canvas.Top="3">
                                            <Ellipse.Effect><DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
                                        </Ellipse>
                                    </Canvas>
                                </Grid>

                                <TextBlock Text="SPEED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6"/>
                                <Slider x:Name="SpeedSlider" Minimum="0" Maximum="1" Value="0.5" Style="{StaticResource QSlider}" ValueChanged="Slider_Changed"/>
                                <TextBlock Text="BRIGHTNESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/>
                                <Slider x:Name="BriSlider" Minimum="0" Maximum="1" Value="1" Style="{StaticResource QSlider}" ValueChanged="Slider_Changed"/>

                                <CheckBox x:Name="ReverseBox" Style="{StaticResource Toggle}" Content="Reverse direction" Margin="0,20,0,0" Click="Toggle_Click"/>
                                <CheckBox x:Name="SyncBox" Style="{StaticResource Toggle}" Content="Sync all devices" Margin="0,12,0,0" Click="Toggle_Click" IsChecked="True"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
