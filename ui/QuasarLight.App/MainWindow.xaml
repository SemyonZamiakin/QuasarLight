<Window x:Class="QuasarLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quasar Light" Width="1200" Height="760" MinWidth="1100" MinHeight="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border Margin="10" CornerRadius="8" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid x:Name="TitleBar" Background="{StaticResource PanelBg}" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Path Data="M0,7 A7,7 0 1 1 14,7 A7,7 0 1 1 0,7 M4,7 A3,3 0 1 0 10,7 A3,3 0 1 0 4,7" Fill="{StaticResource AccentBrush}" Stretch="None"/>
                    <TextBlock Text="Quasar Light" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="RGB control" Margin="8,0,0,0" Foreground="{StaticResource DimBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinBtn}" Click="Min_Click" ToolTip="Minimize">
                        <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="Close_Click" ToolTip="Hide to tray">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="318"/>
                </Grid.ColumnDefinitions>

                <!-- devices -->
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="BACKEND" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="BackendDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BackendText" Text="OpenRGB: not connected" Margin="8,0,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxWidth="190"/>
                                </StackPanel>
                                <TextBlock x:Name="ModeNote" TextWrapping="Wrap" Margin="0,6,0,10" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Text="Hardware is controlled through a local OpenRGB server. Until connected, changes affect the preview only."/>
                                <Button x:Name="BackendBtn" Content="Connect OpenRGB" Height="28" Click="Backend_Click"/>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="DEVICES" Style="{StaticResource SectionLabel}" Margin="16,16,0,8"/>
                            <StackPanel x:Name="DeviceList"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- preview -->
                <Grid Grid.Column="1" Margin="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="ImgSetBtn" Style="{StaticResource GhostBtn}" Content="Set image..." Click="ImgSet_Click" ToolTip="Use your own photo of this device"/>
                            <Button x:Name="ImgClearBtn" Style="{StaticResource GhostBtn}" Content="Clear" Margin="6,0,0,0" Click="ImgClear_Click" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="StageTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="StageSub" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Margin="0,14,0,14" CornerRadius="6" ClipToBounds="True" Background="#0B0C0F"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Grid>
                            <Viewbox x:Name="StageBox" Stretch="Uniform" Margin="10">
                                <Canvas x:Name="Stage" Width="620" Height="440"/>
                            </Viewbox>
                            <Grid x:Name="DeviceView" Visibility="Collapsed" Margin="10">
                                <Ellipse x:Name="DevGlow" Width="480" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.30" IsHitTestVisible="False">
                                    <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
                                </Ellipse>
                                <Image x:Name="DevImage" Stretch="Uniform" Margin="40,30,40,90" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="DevNoImage" Text="No image. Press 'Set image...' to add a photo of this device."
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60" Foreground="{StaticResource DimBrush}"/>
                                <StackPanel x:Name="LedBar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" CornerRadius="6" Padding="14,10" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <TextBlock x:Name="InfoText" FontFamily="Consolas" FontSize="12" Foreground="#BFC5D2" LineHeight="19"/>
                    </Border>
                </Grid>

                <!-- properties -->
                <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
                            <StackPanel>
                                <CheckBox x:Name="AutoBox" Style="{StaticResource Toggle}" Content="Auto-apply changes" Margin="0,0,0,10" Click="Auto_Click" IsEnabled="False"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="ApplyBtn" Content="Apply to hardware" IsEnabled="False" Height="32" Click="Apply_Click"
                                            ToolTip="Connect OpenRGB first"/>
                                    <Button x:Name="RestoreBtn" Grid.Column="1" Content="Restore" IsEnabled="False" Height="32" Width="72" Margin="8,0,0,0" Click="Restore_Click"
                                            ToolTip="Put devices back into the mode they had before Quasar Light"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <StackPanel Margin="18,16,18,16">
                                <TextBlock Text="EFFECT" Style="{StaticResource SectionLabel}"/>
                                <UniformGrid x:Name="EffectPanel" Columns="2"/>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,14"/>
                                <TextBlock Text="COLOR" Style="{StaticResource SectionLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Target1" GroupName="ct" IsChecked="True" Style="{StaticResource Chip}" Content="Primary" Checked="Target_Changed"/>
                                    <RadioButton x:Name="Target2" GroupName="ct" Style="{StaticResource Chip}" Content="Secondary" Checked="Target_Changed"/>
                                    <Border x:Name="HexSwatch" Width="28" Height="28" CornerRadius="4" Margin="6,0,6,6" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                                    <TextBox x:Name="HexBox" Style="{StaticResource HexBox}" Width="78" Height="28" Margin="0,0,0,6"
                                             VerticalContentAlignment="Center" LostFocus="Hex_Commit" KeyDown="Hex_KeyDown"/>
                                </StackPanel>
                                <WrapPanel x:Name="Palette" Margin="0,2,0,0"/>
                                <Grid Margin="0,6,0,0" Height="22">
                                    <Border Height="6" CornerRadius="3" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.17"/>
                                                <GradientStop Color="#00FF00" Offset="0.33"/><GradientStop Color="#00FFFF" Offset="0.5"/>
                                                <GradientStop Color="#0000FF" Offset="0.67"/><GradientStop Color="#FF00FF" Offset="0.83"/>
                                                <GradientStop Color="#FF0000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Style="{StaticResource QSlider}" Opacity="0.01" ValueChanged="Hue_Changed"/>
                                    <Canvas IsHitTestVisible="False" Height="22">
                                        <Ellipse x:Name="HueThumb" Width="14" Height="14" Stroke="#101114" StrokeThickness="2" Canvas.Top="4"/>
                                    </Canvas>
                                </Grid>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,14"/>
                                <TextBlock Text="PARAMETERS" Style="{StaticResource SectionLabel}"/>
                                <DockPanel>
                                    <TextBlock x:Name="SpeedVal" DockPanel.Dock="Right" Width="38" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/>
                                    <TextBlock Text="Speed" Foreground="{StaticResource TextBrush}"/>
                                </DockPanel>
                                <Slider x:Name="SpeedSlider" Minimum="0" Maximum="1" Value="0.5" Style="{StaticResource QSlider}" ValueChanged="Slider_Changed" Margin="0,2,0,8"/>
                                <DockPanel>
                                    <TextBlock x:Name="BriVal" DockPanel.Dock="Right" Width="38" TextAlignment="Right" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/>
                                    <TextBlock Text="Brightness" Foreground="{StaticResource TextBrush}"/>
                                </DockPanel>
                                <Slider x:Name="BriSlider" Minimum="0" Maximum="1" Value="1" Style="{StaticResource QSlider}" ValueChanged="Slider_Changed" Margin="0,2,0,0"/>

                                <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,14"/>
                                <TextBlock Text="OPTIONS" Style="{StaticResource SectionLabel}"/>
                                <CheckBox x:Name="ReverseBox" Style="{StaticResource Toggle}" Content="Reverse direction" Click="Toggle_Click"/>
                                <CheckBox x:Name="SyncBox" Style="{StaticResource Toggle}" Content="Apply to all devices" Margin="0,10,0,0" Click="Toggle_Click" IsChecked="True"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- status bar -->
            <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="v0.1.0 · MIT" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DimBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
